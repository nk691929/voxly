# Copy to .env.local and fill in. Never commit .env.local.
# With no AI keys the app writes placeholder results. Supabase is required for sign-in.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Needed for "Delete my account". Full admin power: never share it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Text writing (emails, notes, tasks, translation) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional: force a provider ("deepseek" or "openai"). Empty = DeepSeek if its key is set, else OpenAI.
AI_TEXT_PROVIDER=

# --- OpenAI (speech-to-text, and text when you switch later) ---
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TEXT_MODEL=gpt-4o-mini

NEXT_PUBLIC_SITE_URL=http://localhost:3000
